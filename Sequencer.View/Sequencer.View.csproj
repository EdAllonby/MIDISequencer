<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sequencer</AssemblyName>
    <RootNamespace>Sequencer.View</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="log4net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sequencer.Audio\Sequencer.Audio.csproj" />
    <ProjectReference Include="..\Sequencer.Domain\Sequencer.Domain.csproj" />
    <ProjectReference Include="..\Sequencer.Midi\Sequencer.Midi.csproj" />
    <ProjectReference Include="..\Sequencer.Utilities\Sequencer.Utilities.csproj" />
    <ProjectReference Include="..\Sequencer.ViewModel\Sequencer.ViewModel.csproj" />
    <ProjectReference Include="..\Sequencer.Visual\Sequencer.Visual.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sequencer.View.Tests" />
  </ItemGroup>

</Project>
