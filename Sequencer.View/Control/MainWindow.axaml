<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="using:Sequencer.View.Control"
        xmlns:radial="using:Sequencer.View.Control.RadialContextMenu"
        xmlns:view="using:Sequencer.View"
        xmlns:vm="using:Sequencer.ViewModel"
        x:Class="Sequencer.View.Control.MainWindow"
        x:DataType="vm:SequencerViewModel"
        Icon="/Assets/AppIcon.png"
        Title="Sequencer" Width="1280" Height="860" MinWidth="960" MinHeight="640">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto,280">

        <!-- The File menu: in the menu bar on macOS, drawn here on Windows and Linux. -->
        <NativeMenuBar Grid.Row="0" Grid.ColumnSpan="3" />

        <!-- Toolbar: transport and position on the left, tools on the right. -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="12,9">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Classes="icon" Classes.playing="{Binding IsPlaying}" Focusable="False"
                            Command="{Binding ToggleSequencer}" ToolTip.Tip="Play / pause (Space)">
                        <Panel>
                            <Path Data="{x:Static view:Icons.Play}" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"
                                  Stretch="Uniform" IsVisible="{Binding !IsPlaying}" />
                            <Path Data="{x:Static view:Icons.Pause}" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"
                                  Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button x:Name="StopButton" Classes="icon" Focusable="False" Command="{Binding StopSequencer}"
                            ToolTip.Tip="Stop and return to the start (Return)">
                        <Path Data="{x:Static view:Icons.Stop}" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource FieldBrush}" CornerRadius="7" Padding="12,4"
                        MinWidth="96" VerticalAlignment="Center" ToolTip.Tip="Playback position (bar . beat . sixteenth)">
                    <TextBlock x:Name="PositionReadout" Classes="readout" Text="{Binding PositionText}" HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="20,0,0,0" VerticalAlignment="Center">
                    <NumericUpDown x:Name="TempoBox" Classes="tempo" Width="64" Minimum="30" Maximum="300" Increment="1" FormatString="0"
                                   ShowButtonSpinner="False" HorizontalContentAlignment="Center"
                                   Value="{Binding BeatsPerMinute}" ToolTip.Tip="Tempo in beats per minute: type a value, or use ↑ ↓" />
                    <TextBlock Classes="label" Text="BPM" VerticalAlignment="Center" />
                    <Button x:Name="TapButton" Classes="quiet" Content="Tap" Focusable="False" Command="{Binding TapTempo}"
                            ToolTip.Tip="Tap in time to set the tempo" />
                    <Border Classes="segmented" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="segment" x:Name="SectionModeButton" Focusable="False" IsChecked="{Binding IsSectionMode}"
                                          Content="Section" ToolTip.Tip="Loop the selected section while you work on it" />
                            <ToggleButton Classes="segment" x:Name="SongModeButton" Focusable="False" IsChecked="{Binding IsSongMode}"
                                          Content="Song" ToolTip.Tip="Play the whole arrangement from the start" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Classes="segmented" VerticalAlignment="Center" IsEnabled="{Binding IsSynthTrack}"
                        ToolTip.Tip="Tools for the piano roll">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton Classes="segment" x:Name="SelectToolButton" Focusable="False" IsChecked="{Binding IsSelectTool}"
                                      ToolTip.Tip="Select, move and resize notes (V)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="stroke-icon" Data="{x:Static view:Icons.Select}" Width="14" Height="14" />
                                <TextBlock Text="Select" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="segment" x:Name="DrawToolButton" Focusable="False" IsChecked="{Binding IsDrawTool}"
                                      ToolTip.Tip="Draw notes (D)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="stroke-icon" Data="{x:Static view:Icons.Draw}" Width="14" Height="14" />
                                <TextBlock Text="Draw" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="segment" x:Name="EraseToolButton" Focusable="False" IsChecked="{Binding IsEraseTool}"
                                      ToolTip.Tip="Erase notes (E)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="stroke-icon" Data="{x:Static view:Icons.Erase}" Width="14" Height="14" />
                                <TextBlock Text="Erase" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arrangement: tracks of clips across four-bar sections. -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="ArrangementScrollViewer" MaxHeight="290" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <control:ArrangementControl x:Name="Arrangement" />
            </ScrollViewer>
        </Border>

        <!-- Editor: the clip's title, the ruler, then the piano roll or the drum grid. -->
        <Grid Grid.Row="3" Grid.Column="0">
            <DockPanel>
                <!-- Which track is being edited, and its presets. -->
                <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="ClipColour" Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClipTitle" Text="Synth" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClipDetail" Classes="label" Text="" VerticalAlignment="Center" />
                        </StackPanel>
                        <Panel Grid.Column="2">
                            <Button x:Name="TunesButton" IsVisible="{Binding IsSynthTrack}" Classes="quiet" Focusable="False" ToolTip.Tip="Load a well-known tune to play or edit">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="stroke-icon" Data="{x:Static view:Icons.Tunes}" Stroke="{Binding $parent[Button].Foreground}" Width="14" Height="14" />
                                    <TextBlock Text="Tunes" VerticalAlignment="Center" />
                                    <Path Classes="stroke-icon" Data="{x:Static view:Icons.ChevronDown}" Stroke="{StaticResource TextTertiaryBrush}" Width="10" Height="10" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LoopsButton" Classes="quiet" Focusable="False" IsVisible="{Binding IsDrumTrack}"
                                    ToolTip.Tip="Load a classic drum pattern">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="stroke-icon" Data="{x:Static view:Icons.DrumTrack}" Stroke="{Binding $parent[Button].Foreground}" Width="14" Height="14" />
                                    <TextBlock Text="Loops" VerticalAlignment="Center" />
                                    <Path Classes="stroke-icon" Data="{x:Static view:Icons.ChevronDown}" Stroke="{StaticResource TextTertiaryBrush}" Width="10" Height="10" />
                                </StackPanel>
                            </Button>
                        </Panel>
                    </Grid>
                </Border>

                <!-- The left column and the ruler's spacer share one width so lanes, steps and beats line up. -->
                <Grid DockPanel.Dock="Top" Height="28" ColumnDefinitions="72,*" Background="{StaticResource PanelBrush}">
                    <control:SequencerHeaderControl x:Name="Header" Grid.Column="1"
                                                    CurrentPosition="{Binding CurrentPosition}" />
                </Grid>
                <Panel>
                    <ScrollViewer x:Name="EditorScrollViewer" IsVisible="{Binding IsSynthTrack}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False">
                        <Grid ColumnDefinitions="72,*" MinHeight="800">
                            <control:PianoKeyboardControl x:Name="Keyboard" Grid.Column="0" />
                            <control:SequencerControl x:Name="Editor" Grid.Column="1"
                                                      NoteAction="{Binding NoteAction}"
                                                      SelectedNotes="{Binding SelectedNotes, Mode=TwoWay}"
                                                      CurrentPosition="{Binding CurrentPosition}" />
                        </Grid>
                    </ScrollViewer>
                    <StackPanel x:Name="DrumArea" IsVisible="{Binding IsDrumTrack}" Background="{StaticResource WindowBrush}">
                        <control:DrumEditorControl x:Name="DrumEditor" />
                        <TextBlock x:Name="DrumEmptyHint" Classes="label" Margin="84,16,16,0" Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="Click the steps to build a beat, or load one from Loops." />
                    </StackPanel>

                    <!-- An empty section: nothing to edit until there's a clip, so nothing is drawn into thin air. -->
                    <Border x:Name="NoClipPanel" IsVisible="False" Background="{StaticResource WindowBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock x:Name="NoClipTitle" Text="No clip in this section" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Classes="label" HorizontalAlignment="Center"
                                       Text="Make a new one, or double-click the cell in the arrangement." />
                            <Button x:Name="NewClipButton" Classes="quiet accent" Content="New clip" Focusable="False" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </DockPanel>

            <!-- Shown on an empty grid with the Draw tool, so the first step is obvious. -->
            <Border x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="72,28,0,0" Background="{StaticResource ToolbarBrush}" CornerRadius="8" Padding="16,10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock Text="Click anywhere in the grid to draw a note" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="label" Text="or load one from Tunes, then press Space to play" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <radial:NoteActionRadialContextMenuWrapper x:Name="NoteActionMenu"
                                                       SelectedMenuItem="{Binding NoteAction, Mode=TwoWay}"
                                                       MenuRadius="52" />
        </Grid>

        <GridSplitter Grid.Row="3" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

        <!-- Side panel: the selected note, then the synth. -->
        <Border Grid.Row="3" Grid.Column="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,14,16,16" Spacing="12">
                <StackPanel Spacing="12" IsVisible="{Binding IsSynthTrack}">

                    <TextBlock Classes="section" Text="NOTE" />
                    <StackPanel Spacing="2" IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock Text="No note selected" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Classes="label" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Select a single note to see its details." />
                    </StackPanel>
                    <StackPanel x:Name="NoteDetails" Spacing="10"
                                IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock x:Name="SelectedPitch" Text="{Binding SelectedNote.Pitch, FallbackValue=''}" FontSize="24" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Classes="label" Text="Start" />
                                <TextBlock x:Name="SelectedStart" Classes="value" Text="{Binding SelectedNote.Start, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Classes="label" Text="Length" />
                                <TextBlock x:Name="SelectedLength" Classes="value" Text="{Binding SelectedNote.Length, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Classes="label" Text="End" />
                                <TextBlock Classes="value" Text="{Binding SelectedNote.End, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                <TextBlock Classes="label" Text="Velocity" />
                                <TextBlock x:Name="SelectedVelocity" Classes="value" Text="{Binding SelectedNote.Velocity, FallbackValue=''}" />
                                <ProgressBar Height="3" MinHeight="3" MinWidth="0" Minimum="0" Maximum="100" CornerRadius="1.5"
                                             Value="{Binding SelectedNote.VelocityPercent, FallbackValue=0}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,6" />

                    <StackPanel x:Name="SynthPanel" x:DataType="vm:SynthViewModel" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="SYNTH" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="PresetsButton" Classes="quiet" Focusable="False" ToolTip.Tip="Start from a classic sound">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Presets" VerticalAlignment="Center" />
                                    <Path Classes="stroke-icon" Data="{x:Static view:Icons.ChevronDown}" Stroke="{StaticResource TextTertiaryBrush}" Width="10" Height="10" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Spacing="2" ToolTip.Tip="This track's volume">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Volume" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding VolumePercent, StringFormat='{}{0} %'}" />
                            </Grid>
                            <Slider x:Name="VolumePercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Focusable="False" Margin="0,-6,0,-4" Value="{Binding VolumePercent}" />
                        </StackPanel>
                        <Expander x:Name="OscillatorsSection" Classes="synth" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Classes="section" Text="OSCILLATORS" />
                            </Expander.Header>
                            <StackPanel Spacing="10">
                            <TextBlock Classes="label" Text="Oscillator 1" />
                            <Border Classes="segmented">
                                <UniformGrid Columns="4">
                                    <ToggleButton Classes="segment" x:Name="SawtoothWaveButton" Focusable="False" ToolTip.Tip="Sawtooth (oscillator 1)"
                                                  IsChecked="{Binding IsSawtooth}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Sawtooth}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="SquareWaveButton" Focusable="False" ToolTip.Tip="Square (oscillator 1)"
                                                  IsChecked="{Binding IsSquare}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Square}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="TriangleWaveButton" Focusable="False" ToolTip.Tip="Triangle (oscillator 1)"
                                                  IsChecked="{Binding IsTriangle}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Triangle}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="SineWaveButton" Focusable="False" ToolTip.Tip="Sine (oscillator 1)"
                                                  IsChecked="{Binding IsSine}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Sine}" Width="20" Height="14" />
                                    </ToggleButton>
                                </UniformGrid>
                            </Border>
                            <TextBlock Classes="label" Text="Oscillator 2" Margin="0,4,0,0" />
                            <Border Classes="segmented">
                                <UniformGrid Columns="4">
                                    <ToggleButton Classes="segment" x:Name="Osc2SawtoothWaveButton" Focusable="False" ToolTip.Tip="Sawtooth (oscillator 2)"
                                                  IsChecked="{Binding IsOscillator2Sawtooth}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Sawtooth}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="Osc2SquareWaveButton" Focusable="False" ToolTip.Tip="Square (oscillator 2)"
                                                  IsChecked="{Binding IsOscillator2Square}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Square}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="Osc2TriangleWaveButton" Focusable="False" ToolTip.Tip="Triangle (oscillator 2)"
                                                  IsChecked="{Binding IsOscillator2Triangle}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Triangle}" Width="20" Height="14" />
                                    </ToggleButton>
                                    <ToggleButton Classes="segment" x:Name="Osc2SineWaveButton" Focusable="False" ToolTip.Tip="Sine (oscillator 2)"
                                                  IsChecked="{Binding IsOscillator2Sine}">
                                        <Path Classes="stroke-icon" Data="{x:Static view:Icons.Sine}" Width="20" Height="14" />
                                    </ToggleButton>
                                </UniformGrid>
                            </Border>
                            <StackPanel Spacing="2" ToolTip.Tip="Oscillator 2's tuning: 12 is an octave up, 7 a fifth">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Pitch" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Oscillator2Semitones, StringFormat='{}{0:+0;-0;0} st'}" />
                                </Grid>
                                <Slider x:Name="Oscillator2SemitonesSlider" Minimum="-24" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding Oscillator2Semitones}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="A few cents makes the oscillators beat, for a thicker sound">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Detune" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Oscillator2DetuneCents, StringFormat='{}{0:+0;-0;0} ct'}" />
                                </Grid>
                                <Slider x:Name="Oscillator2DetuneCentsSlider" Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding Oscillator2DetuneCents}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How much of oscillator 2 to hear against oscillator 1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Mix" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding OscillatorMixText}" />
                                </Grid>
                                <Slider x:Name="OscillatorMixPercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding OscillatorMixPercent}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="White noise, for breath or grit">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Noise" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding NoisePercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="NoisePercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding NoisePercent}" />
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="FilterSection" Classes="synth" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Classes="section" Text="FILTER" />
                            </Expander.Header>
                            <StackPanel Spacing="10">
                            <Border Classes="segmented">
                                <UniformGrid Columns="3">
                                    <ToggleButton Classes="segment" x:Name="LowPassButton" Focusable="False" Content="Low" ToolTip.Tip="Low-pass: keeps the lows, darker as the cutoff falls"
                                                  IsChecked="{Binding IsLowPass}" />
                                    <ToggleButton Classes="segment" x:Name="HighPassButton" Focusable="False" Content="High" ToolTip.Tip="High-pass: keeps the highs, thinner as the cutoff rises"
                                                  IsChecked="{Binding IsHighPass}" />
                                    <ToggleButton Classes="segment" x:Name="BandPassButton" Focusable="False" Content="Band" ToolTip.Tip="Band-pass: keeps a band around the cutoff"
                                                  IsChecked="{Binding IsBandPass}" />
                                </UniformGrid>
                            </Border>
                            <StackPanel Spacing="2" ToolTip.Tip="Where the filter starts to cut">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Cutoff" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding CutoffText}" />
                                </Grid>
                                <Slider x:Name="CutoffPositionSlider" Minimum="0" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding CutoffPosition}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="Emphasises frequencies at the cutoff; high values whistle">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Resonance" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding ResonancePercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="ResonancePercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding ResonancePercent}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How far the filter envelope moves the cutoff">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Envelope amount" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FilterEnvelopeAmountText}" />
                                </Grid>
                                <Slider x:Name="FilterEnvelopeAmountTenthsSlider" Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding FilterEnvelopeAmountTenths}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="Higher notes open the filter more">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Key tracking" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding KeyTrackingPercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="KeyTrackingPercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding KeyTrackingPercent}" />
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="FilterEnvelopeSection" Classes="synth" IsExpanded="False" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Classes="section" Text="FILTER ENVELOPE" />
                            </Expander.Header>
                            <StackPanel Spacing="10">
                            <Border Background="{StaticResource FieldBrush}" CornerRadius="7" Height="56" Padding="6" ToolTip.Tip="How the filter's cutoff moves over each note">
                                <control:EnvelopeGraph x:Name="FilterEnvelopeGraph" Stroke="{StaticResource AccentBrush}"
                                                       AttackMilliseconds="{Binding FilterAttackMilliseconds}" DecayMilliseconds="{Binding FilterDecayMilliseconds}"
                                                       SustainPercent="{Binding FilterSustainPercent}" ReleaseMilliseconds="{Binding FilterReleaseMilliseconds}" />
                            </Border>
                            <StackPanel Spacing="2" ToolTip.Tip="How long the filter takes to open">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Attack" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FilterAttackMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="FilterAttackMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding FilterAttackMilliseconds}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How long it then takes to fall to the sustain level">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Decay" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FilterDecayMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="FilterDecayMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding FilterDecayMilliseconds}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="Where it settles while the note is held">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Sustain" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FilterSustainPercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="FilterSustainPercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding FilterSustainPercent}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How long it takes to close after the note ends">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Release" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FilterReleaseMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="FilterReleaseMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding FilterReleaseMilliseconds}" />
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="AmpEnvelopeSection" Classes="synth" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Classes="section" Text="AMP ENVELOPE" />
                            </Expander.Header>
                            <StackPanel Spacing="10">
                            <Border Background="{StaticResource FieldBrush}" CornerRadius="7" Height="56" Padding="6" ToolTip.Tip="How each note's volume changes over time">
                                <control:EnvelopeGraph x:Name="Envelope" Stroke="{StaticResource AccentBrush}"
                                                       AttackMilliseconds="{Binding AttackMilliseconds}" DecayMilliseconds="{Binding DecayMilliseconds}"
                                                       SustainPercent="{Binding SustainPercent}" ReleaseMilliseconds="{Binding ReleaseMilliseconds}" />
                            </Border>
                            <StackPanel Spacing="2" ToolTip.Tip="How long a note takes to reach full volume">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Attack" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding AttackMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="AttackMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding AttackMilliseconds}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How long it then takes to fall to the sustain level">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Decay" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding DecayMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="DecayMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding DecayMilliseconds}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="The level a held note settles at">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Sustain" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SustainPercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="SustainPercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding SustainPercent}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How long a note takes to fade after it ends">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Release" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding ReleaseMilliseconds, StringFormat='{}{0} ms'}" />
                                </Grid>
                                <Slider x:Name="ReleaseMillisecondsSlider" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding ReleaseMilliseconds}" />
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="LfoSection" Classes="synth" IsExpanded="False" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Classes="section" Text="LFO" />
                            </Expander.Header>
                            <StackPanel Spacing="10">
                            <Border Classes="segmented">
                                <UniformGrid Columns="3">
                                    <ToggleButton Classes="segment" x:Name="LfoPitchButton" Focusable="False" Content="Pitch" ToolTip.Tip="Vibrato"
                                                  IsChecked="{Binding IsLfoOnPitch}" />
                                    <ToggleButton Classes="segment" x:Name="LfoFilterButton" Focusable="False" Content="Filter" ToolTip.Tip="Sweeps the cutoff: wobbles"
                                                  IsChecked="{Binding IsLfoOnFilter}" />
                                    <ToggleButton Classes="segment" x:Name="LfoVolumeButton" Focusable="False" Content="Volume" ToolTip.Tip="Tremolo"
                                                  IsChecked="{Binding IsLfoOnVolume}" />
                                </UniformGrid>
                            </Border>
                            <StackPanel Spacing="2" ToolTip.Tip="How fast the LFO cycles">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Rate" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding LfoRateText}" />
                                </Grid>
                                <Slider x:Name="LfoRateTenthsSlider" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding LfoRateTenths}" />
                            </StackPanel>
                            <StackPanel Spacing="2" ToolTip.Tip="How much it moves its target; 0 is off">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Depth" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding LfoDepthPercent, StringFormat='{}{0} %'}" />
                                </Grid>
                                <Slider x:Name="LfoDepthPercentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Focusable="False" Margin="0,-6,0,-4" Value="{Binding LfoDepthPercent}" />
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>

                    <!-- The drum kit's settings, when the drum track is being edited. -->
                    <StackPanel x:Name="DrumKitPanel" Spacing="12" IsVisible="{Binding IsDrumTrack}">
                        <TextBlock Classes="section" Text="DRUMS" />
                        <TextBlock Classes="label" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Six synthesised drum sounds. A closed hi-hat cuts off an open one, as on a drum machine." />
                        <StackPanel x:Name="DrumVolumeRow" x:DataType="vm:DrumKitViewModel" Spacing="2" ToolTip.Tip="Drum kit volume">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Volume" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding VolumePercent, StringFormat='{}{0} %'}" />
                            </Grid>
                            <Slider x:Name="DrumVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Focusable="False" Margin="0,-6,0,-4" Value="{Binding VolumePercent}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,2" />
                    <control:EffectsPanel x:Name="EffectsPanel" />

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,2" />
                    <CheckBox x:Name="PreviewOnEditBox" Content="Play sounds while editing" Focusable="False" FontSize="12"
                              IsChecked="{Binding PreviewOnEdit}" ToolTip.Tip="Hear notes and drum hits as you add or change them" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Hint bar: what the current tool does, and the main shortcuts. -->
        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ToolHintText" Classes="label" Text="{Binding ToolHint}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="label" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,0,0,0"
                           Text="Space play / pause  ·  Return stop  ·  ⌘D repeat clip  ·  V D E tools" />
            </Grid>
        </Border>
    </Grid>
</Window>
